# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# ============================================
# BUGPROOF BACKEND CONFIGURATION
# ============================================

# Flask configuration
APP_ENV=development
FLASK_PORT=5000
FLASK_SECRET_KEY=replace-with-a-random-secret-key

# PostgreSQL database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bugproof
DB_USER=bugproof_user
DB_PASSWORD=replace-with-your-db-password

# Full DATABASE_URL (used in production, overrides individual DB_ vars)
DATABASE_URL=

# Test database (used when APP_ENV=testing)
TEST_DATABASE_URL=postgresql://bugproof_user:replace-password@localhost:5432/bugproof_test

# ============================================
# IBM WATSONX AI SERVICE
# ============================================
# Required to enable AI-assisted investigation, root cause analysis,
# and fix generation.  Leave blank to run in machine-only mode.

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ============================================
# REPOSITORY WORKSPACE
# ============================================
# Directory where target repositories (thefuck, tqdm, youtube-dl)
# are checked out.  Defaults to workspace/repos/ relative to project root.

REPOS_WORKSPACE=./workspace/repos

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use os.environ.get('VARIABLE_NAME') to access values
# - Never share credentials with AI assistants like Bob
# ============================================
